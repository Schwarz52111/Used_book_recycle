# ---- 数据库 ----
# 想不装 MySQL 先试跑，取消下面这行注释用 SQLite（单文件，零配置）：
# DATABASE_URL=sqlite:///./used_books.db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=used_book_recycle

# ---- VLM（云为主，本地降级）----
# provider 可选: openai_compatible | ollama
VLM_PROVIDER=openai_compatible
# 云 VLM（OpenAI 兼容接口，如阿里通义/智谱/OpenAI 等）
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_API_KEY=change_me
VLM_MODEL=qwen-vl-plus
# 本地 Ollama 降级
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b

# ---- 识别 ----
# 留空则用系统 PATH 中的 tesseract
TESSERACT_CMD=
# 外部 ISBN 元数据查询接口（OpenAI 兼容/自建均可，留空则跳过）
ISBN_METADATA_URL=

# ---- 业务参数 ----
# 识别/品相置信度低于此值进入人工复核
REVIEW_CONFIDENCE_THRESHOLD=0.6
# 默认基础回收率（书目未配置时）
DEFAULT_BASE_RECYCLE_RATE=0.35

# ---- 支付与出货 ----
# 支付方式：mock（开发期，发起即成功）| wechat（需补全下方商户凭证）
PAYMENT_PROVIDER=mock
# 出货机制：simulated | vend_channel | rfid_door
DISPENSE_MECHANISM=simulated

# ---- 微信登录（小程序）----
# 登录方式：mock（开发期，code 直接换 openid）| wechat（需 AppID/Secret）
AUTH_PROVIDER=mock
WECHAT_APPID=
WECHAT_SECRET=

# ---- 微信支付 v3（拿到商户凭证后填写并把 PAYMENT_PROVIDER 改为 wechat）----
# 复用上面的 WECHAT_APPID
WECHAT_MCHID=                 # 商户号
WECHAT_API_V3_KEY=           # APIv3 密钥（32 位）
WECHAT_CERT_SERIAL=          # 商户证书序列号
WECHAT_PRIVATE_KEY=          # 商户私钥：PEM 内容，或指向 apiclient_key.pem 的文件路径
WECHAT_NOTIFY_URL=           # 支付回调，需已备案 HTTPS，如 https://your.domain/pay/wechat/notify
