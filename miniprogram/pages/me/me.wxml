<view class="wrap">
  <view wx:if="{{loading}}" class="spinner"></view>

  <block wx:elif="{{user}}">
    <view class="card profile">
      <view class="avatar">绿</view>
      <view class="uinfo">
        <view class="nick">{{user.nickname || '校园用户'}}</view>
        <view class="oid muted">openid：{{user.openid}}</view>
      </view>
    </view>

    <view class="card stat">
      <view class="stat-item">
        <view class="stat-num">{{user.balanceText}}</view>
        <view class="muted">账户余额</view>
      </view>
      <view class="divider"></view>
      <view class="stat-item">
        <view class="stat-num">{{user.credit_score}}</view>
        <view class="muted">信用分</view>
      </view>
    </view>

    <view class="hint muted">卖书回收的金额会自动到账这里。购书在「买书」页完成。</view>
  </block>

  <view wx:else class="empty">
    <view class="muted">{{error || '未登录'}}</view>
    <button class="btn" bindtap="refresh">点击登录</button>
  </view>
</view>
