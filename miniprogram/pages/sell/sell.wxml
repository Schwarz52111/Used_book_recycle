<view class="wrap">
  <view class="hd">
    <view class="hd-title">卖书回收</view>
    <view class="hd-sub muted">拍下封面，AI 自动估价，确认即到账</view>
  </view>

  <!-- 拍照区 -->
  <view class="shot card" wx:if="{{stage !== 'done'}}">
    <view wx:if="{{!photo}}" class="shot-empty" bindtap="pick">
      <view class="cam">📷</view>
      <view class="shot-tip">点击拍照 / 选择封面图片</view>
      <view class="muted small">对准封面，有 ISBN 条码识别更准</view>
    </view>
    <view wx:else class="shot-preview">
      <image src="{{photo}}" mode="aspectFill" class="preview" />
      <view class="shot-actions">
        <button class="btn btn-ghost mini" bindtap="pick">重拍</button>
        <button class="btn mini" loading="{{stage==='loading'}}" bindtap="appraise">
          {{stage==='loading' ? '识别中…' : '开始估价'}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{error}}" class="err">{{error}}</view>

  <!-- 结果 -->
  <block wx:if="{{stage === 'result' && result}}">
    <view class="card result">
      <view class="bk">
        <view class="bk-cover" style="background: linear-gradient(150deg, {{result.c1}}, {{result.c2}})">
          <text class="bkc-title">{{result.title}}</text>
        </view>
        <view class="bk-meta">
          <view class="bk-title">{{result.title}}</view>
          <view class="muted small">{{result.author}}</view>
          <view class="muted small">识别 {{result.method}} · {{result.confidence}}%</view>
        </view>
        <text class="badge" style="background: {{result.condColor}}">{{result.condLabel}}</text>
      </view>

      <view wx:if="{{result.canRecycle}}" class="price-edit">
        <view class="pe-head">
          <text class="pe-label">回收价 · 给你</text>
          <text class="pe-ai">AI 估价 ¥{{result.aiPrice}}</text>
        </view>
        <view class="pe-stepper">
          <view class="step" bindtap="decPrice">−</view>
          <view class="pe-input">
            <text class="pe-unit">¥</text>
            <input class="pe-field" type="digit" value="{{editPrice}}" bindinput="onPriceInput" />
          </view>
          <view class="step" bindtap="incPrice">＋</view>
        </view>
        <view class="pe-tip muted small">点 − / ＋ 或直接输入修改。高于 AI 估价将提交人工复核后处理。</view>
        <view class="sale-line muted small">预计上架售价 {{result.saleText}}</view>
      </view>

      <view wx:else class="notice">{{result.notice}}</view>

      <view wx:if="{{result.summary}}" class="reason">品相说明：{{result.summary}}</view>

      <view class="dims">
        <view wx:for="{{result.dims}}" wx:key="name" class="dim">
          <view class="dim-top"><text>{{item.name}}</text><text>{{item.pct}}%</text></view>
          <view class="bar"><view class="bar-in {{item.warn ? 'warn' : ''}}" style="width: {{item.pct}}%"></view></view>
        </view>
      </view>

      <view wx:if="{{result.canRecycle && result.reason}}" class="reason">{{result.reason}}</view>

      <view class="acts">
        <button class="btn btn-ghost" bindtap="reset">重拍</button>
        <button wx:if="{{result.canRecycle}}" class="btn" bindtap="confirmRecycle">确认回收 ¥{{editPrice}}</button>
      </view>
    </view>
  </block>

  <!-- 完成 -->
  <view wx:if="{{stage === 'done'}}" class="done card">
    <view class="ok">✓</view>
    <view class="done-title">回收成功</view>
    <view class="done-amt">¥{{payout}} 已到账</view>
    <view wx:if="{{reviewing}}" class="muted small">你的报价高于 AI 估价，已按估价先行到账；更高报价已提交运营复核。</view>
    <view wx:else class="muted small">请将书放入设备投书口 · 感谢你为绿色校园出力</view>
    <button class="btn" bindtap="reset">再卖一本</button>
  </view>
</view>
