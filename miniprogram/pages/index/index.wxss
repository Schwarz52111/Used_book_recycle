.wrap { padding: 24rpx; }
.hero { padding: 16rpx 8rpx 28rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; color: var(--forest); }
.hero-sub { font-size: 26rpx; margin-top: 6rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.pcard { width: 48%; margin-bottom: 24rpx; padding: 16rpx; box-sizing: border-box; }

/* 生成式封面 · 书脊档案 */
.cover {
  height: 250rpx; border-radius: 12rpx; padding: 24rpx 22rpx; box-sizing: border-box;
  display: flex; flex-direction: column; position: relative; overflow: hidden;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.08);
}
.cover::after {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 10rpx;
  background: rgba(0,0,0,0.18);
}
.cv-kicker { color: rgba(255,255,255,0.7); font-size: 20rpx; letter-spacing: 4rpx; }
.cv-title {
  color: #fff; font-size: 32rpx; font-weight: 700; line-height: 1.35; margin-top: 14rpx;
  font-family: Georgia, "Songti SC", serif;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
}
.cv-rule { width: 46rpx; height: 3rpx; background: rgba(255,255,255,0.5); margin-top: auto; }
.cv-foot { color: rgba(255,255,255,0.6); font-size: 19rpx; letter-spacing: 3rpx; margin-top: 12rpx; }

.row { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding: 0 4rpx; }
.price { font-size: 34rpx; }
.empty { text-align: center; padding: 100rpx 0; font-size: 28rpx; }
