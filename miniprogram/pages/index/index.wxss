.wrap { padding: 24rpx; }
.hero { padding: 16rpx 8rpx 28rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; color: var(--forest); }
.hero-sub { font-size: 26rpx; margin-top: 6rpx; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.pcard { width: 48%; margin-bottom: 24rpx; padding: 20rpx; box-sizing: border-box; }
.cover { height: 150rpx; border-radius: 12rpx; background: var(--olive-soft); display: flex; align-items: center; justify-content: center; font-size: 64rpx; }
.title { font-size: 30rpx; font-weight: 600; color: var(--forest); margin-top: 16rpx; line-height: 1.3; }
.isbn { font-size: 22rpx; margin-top: 6rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.price { font-size: 34rpx; }
.empty { text-align: center; padding: 100rpx 0; font-size: 28rpx; }
