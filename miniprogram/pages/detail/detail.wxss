.wrap { padding: 32rpx; }
.detail { padding: 30rpx; text-align: center; }
.cover {
  height: 360rpx; border-radius: 16rpx; padding: 40rpx 36rpx; box-sizing: border-box;
  display: flex; flex-direction: column; text-align: left; position: relative; overflow: hidden;
}
.cover::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 14rpx; background: rgba(0,0,0,0.18); }
.cv-kicker { color: rgba(255,255,255,0.7); font-size: 22rpx; letter-spacing: 5rpx; }
.cv-title { color: #fff; font-size: 46rpx; font-weight: 700; line-height: 1.35; margin-top: 18rpx; font-family: Georgia, "Songti SC", serif; }
.cv-rule { width: 56rpx; height: 4rpx; background: rgba(255,255,255,0.5); margin-top: auto; }
.cv-foot { color: rgba(255,255,255,0.6); font-size: 20rpx; letter-spacing: 3rpx; margin-top: 14rpx; }
.isbn { font-size: 24rpx; margin-top: 20rpx; }
.line { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: 28rpx 0 10rpx; }
.price.big { font-size: 52rpx; }
.meta { font-size: 24rpx; margin-top: 8rpx; }
.buybtn { margin-top: 40rpx; }
.tip { font-size: 22rpx; text-align: center; margin-top: 16rpx; }
.err { color: #9a4b2e; text-align: center; margin: 20rpx 0; font-size: 26rpx; }
.done { text-align: center; padding-top: 120rpx; }
.ok { width: 120rpx; height: 120rpx; line-height: 120rpx; margin: 0 auto; border-radius: 50%; background: var(--forest); color: #fff; font-size: 70rpx; }
.done-title { font-size: 40rpx; font-weight: 700; color: var(--forest); margin: 24rpx 0 8rpx; }
.small { font-size: 24rpx; margin-top: 6rpx; }
.done .btn { margin-top: 50rpx; }
.empty { text-align: center; padding: 120rpx 0; }
